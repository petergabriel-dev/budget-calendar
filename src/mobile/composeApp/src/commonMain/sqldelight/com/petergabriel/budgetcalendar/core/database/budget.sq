getTotalSpendingPoolBalance:
SELECT CAST(COALESCE(SUM(account_balance), 0) AS INTEGER)
FROM (
  SELECT
    a.id,
    a.initial_balance + COALESCE(SUM(t.signed_amount), 0) AS account_balance
  FROM accounts a
  LEFT JOIN transactions t
    ON t.account_id = a.id
    AND t.status = 'confirmed'
    WHERE a.type IN ('checking', 'cash')
  GROUP BY a.id, a.initial_balance
);

getPendingAndOverdueForSpendingPool:
SELECT t.status, CAST(t.amount AS INTEGER) AS amount
FROM transactions t
JOIN accounts a ON t.account_id = a.id
WHERE a.type IN ('checking', 'cash')
  AND t.status IN ('pending', 'overdue')
  AND t.type = 'expense'
ORDER BY t.date ASC;

getCreditCardReservedAmount:
SELECT CAST(COALESCE(SUM(reserved_amount), 0) AS INTEGER)
FROM (
  SELECT
    CASE
      WHEN a.initial_balance + COALESCE(SUM(t.signed_amount), 0) < 0
        THEN -(a.initial_balance + COALESCE(SUM(t.signed_amount), 0))
      ELSE 0
    END AS reserved_amount
  FROM accounts a
  LEFT JOIN transactions t
    ON t.account_id = a.id
    AND t.status != 'cancelled'
  WHERE a.type = 'credit_card'
  GROUP BY a.id, a.initial_balance
);

getCreditCardReservations:
SELECT
  a.id AS account_id,
  a.name AS account_name,
  CAST(
    CASE
      WHEN a.initial_balance + COALESCE(SUM(t.signed_amount), 0) < 0
        THEN -(a.initial_balance + COALESCE(SUM(t.signed_amount), 0))
      ELSE 0
    END AS INTEGER
  ) AS reserved_amount
FROM accounts a
LEFT JOIN transactions t
  ON t.account_id = a.id
  AND t.status != 'cancelled'
WHERE a.type = 'credit_card'
GROUP BY a.id, a.name, a.initial_balance
ORDER BY a.name ASC;
