getUserSettings:
SELECT id, sts_low_threshold_percent, created_at, updated_at
FROM user_settings
WHERE id = 1
LIMIT 1;

upsertUserSettings:
INSERT OR REPLACE INTO user_settings(
  id,
  sts_low_threshold_percent,
  created_at,
  updated_at
)
VALUES (
  1,
  :threshold,
  COALESCE((SELECT created_at FROM user_settings WHERE id = 1), :created_at),
  :updated_at
);
