getAllCreditCardSettings:
SELECT id, account_id, credit_limit, statement_balance, due_date, statement_closing_day, payment_due_day, created_at, updated_at
FROM credit_card_settings
ORDER BY created_at DESC;

getCreditCardSettingsByAccountId:
SELECT id, account_id, credit_limit, statement_balance, due_date, statement_closing_day, payment_due_day, created_at, updated_at
FROM credit_card_settings
WHERE account_id = ?;

insertCreditCardSettings:
INSERT INTO credit_card_settings(account_id, credit_limit, statement_balance, due_date, statement_closing_day, payment_due_day, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateCreditCardSettings:
UPDATE credit_card_settings
SET credit_limit = ?,
    statement_balance = ?,
    due_date = ?,
    statement_closing_day = ?,
    payment_due_day = ?,
    updated_at = ?
WHERE account_id = ?;

deleteCreditCardSettings:
DELETE FROM credit_card_settings
WHERE account_id = ?;

getCreditCardProjectedBalance:
SELECT CAST(a.initial_balance + COALESCE(SUM(t.signed_amount), 0) AS INTEGER)
FROM accounts a
LEFT JOIN transactions t
  ON t.account_id = a.id
  AND t.status != 'cancelled'
WHERE a.id = ?
  AND a.type = 'credit_card'
GROUP BY a.id, a.initial_balance;

getAllCreditCardProjectedBalances:
SELECT
  a.id AS account_id,
  CAST(a.initial_balance + COALESCE(SUM(t.signed_amount), 0) AS INTEGER) AS projected_balance
FROM accounts a
LEFT JOIN transactions t
  ON t.account_id = a.id
  AND t.status != 'cancelled'
WHERE a.type = 'credit_card'
GROUP BY a.id, a.initial_balance;
