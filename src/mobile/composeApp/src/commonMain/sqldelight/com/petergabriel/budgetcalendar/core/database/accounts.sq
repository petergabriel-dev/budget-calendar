getAccountById:
SELECT
  a.id,
  a.name,
  a.type,
  CAST(a.initial_balance + COALESCE(SUM(t.signed_amount), 0) AS INTEGER) AS balance,
  a.is_in_spending_pool,
  a.description,
  a.created_at,
  a.updated_at
FROM accounts a
LEFT JOIN transactions t
  ON t.account_id = a.id
  AND t.status = 'confirmed'
WHERE a.id = :id
GROUP BY a.id, a.name, a.type, a.initial_balance, a.is_in_spending_pool, a.description, a.created_at, a.updated_at;

insertAccount:
INSERT INTO accounts(name, type, initial_balance, description, created_at, updated_at)
VALUES (:name, :type, :initial_balance, :description, :created_at, :updated_at);

updateAccount:
UPDATE accounts
SET name = :name,
    type = :type,
    description = :description,
    updated_at = :updated_at
WHERE id = :id;

deleteAccount:
DELETE FROM accounts
WHERE id = ?;

getAllAccountsWithComputedBalance:
SELECT
  a.id,
  a.name,
  a.type,
  CAST(a.initial_balance + COALESCE(SUM(t.signed_amount), 0) AS INTEGER) AS balance,
  a.is_in_spending_pool,
  a.description,
  a.created_at,
  a.updated_at
FROM accounts a
LEFT JOIN transactions t
  ON t.account_id = a.id
  AND t.status = 'confirmed'
GROUP BY a.id, a.name, a.type, a.initial_balance, a.is_in_spending_pool, a.description, a.created_at, a.updated_at
ORDER BY a.created_at DESC;

getLastInsertedAccountId:
SELECT last_insert_rowid();
