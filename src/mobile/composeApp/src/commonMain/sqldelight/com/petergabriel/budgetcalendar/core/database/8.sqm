CREATE TABLE IF NOT EXISTS notifications (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  type TEXT NOT NULL CHECK(type IN (
    'overdue_transactions',
    'rollover_reminder_7',
    'rollover_reminder_5',
    'rollover_reminder_3',
    'sts_low',
    'sts_negative'
  )),
  is_dismissed INTEGER NOT NULL DEFAULT 0,
  trigger_month INTEGER,
  trigger_year INTEGER,
  overdue_count INTEGER,
  projected_rollover INTEGER,
  days_remaining INTEGER,
  current_sts INTEGER,
  pool_balance INTEGER,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_notifications_type_dismissed ON notifications(type, is_dismissed);
CREATE INDEX IF NOT EXISTS idx_notifications_dismissed ON notifications(is_dismissed);
CREATE INDEX IF NOT EXISTS idx_notifications_rollover ON notifications(type, trigger_year, trigger_month);

CREATE TABLE IF NOT EXISTS user_settings (
  id INTEGER NOT NULL PRIMARY KEY DEFAULT 1,
  sts_low_threshold_percent INTEGER NOT NULL DEFAULT 15 CHECK(sts_low_threshold_percent >= 1 AND sts_low_threshold_percent <= 100),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);
