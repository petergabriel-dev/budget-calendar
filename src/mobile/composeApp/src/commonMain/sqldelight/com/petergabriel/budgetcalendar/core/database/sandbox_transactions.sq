getSandboxTransactionsBySnapshot:
SELECT id, snapshot_id, account_id, destination_account_id, amount, signed_amount, date, type, status, description, category, original_transaction_id, created_at, updated_at
FROM sandbox_transactions
WHERE snapshot_id = ?
ORDER BY date ASC, created_at DESC;

insertSandboxTransaction:
INSERT INTO sandbox_transactions(
  snapshot_id,
  account_id,
  destination_account_id,
  amount,
  signed_amount,
  date,
  type,
  status,
  description,
  category,
  original_transaction_id,
  created_at,
  updated_at
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSandboxTransaction:
DELETE FROM sandbox_transactions
WHERE id = ?;

getSandboxTransactionById:
SELECT id, snapshot_id, account_id, destination_account_id, amount, signed_amount, date, type, status, description, category, original_transaction_id, created_at, updated_at
FROM sandbox_transactions
WHERE id = ?;

getLastInsertedSandboxTransactionId:
SELECT last_insert_rowid();